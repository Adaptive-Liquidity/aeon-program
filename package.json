{
  "name": "aeon-program",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "lint:fix": "prettier */*.js \"*/**/*{.js,.ts}\" -w",
    "lint": "prettier */*.js \"*/**/*{.js,.ts}\" --check",
    "test": "bash scripts/run-e2e.sh",
    "test:e2e": "bash scripts/run-e2e.sh",
    "test:sdk": "ts-mocha -p ./tsconfig.json -t 10000 'client/__tests__/**/*.ts'",
    "test:negative": "bash scripts/run-negative.sh",
    "test:fuzz:p2": "bash scripts/run-trident-p2.sh",
    "typecheck:sdk": "tsc --noEmit -p tsconfig.client.json",
    "demo:economy": "bash scripts/run-demo.sh",
    "demo:devnet": "node -r ts-node/register/transpile-only scripts/devnet-demo-escrow-org.ts",
    "deploy:devnet": "bash scripts/deploy-devnet.sh",
    "mine:devnet": "node scripts/pow-mine.mjs --target-sol 4",
    "build:sbf": "cargo-build-sbf --manifest-path programs/aeon/Cargo.toml",
    "ci:prepare": "bash scripts/ci-prepare-deploy.sh",
    "smoke:devnet": "node -r ts-node/register/transpile-only scripts/devnet-smoke.ts",
    "test:heavy-cpi": "bash scripts/run-heavy-cpi.sh",
    "test:heavy-hook": "bash scripts/run-heavy-hook.sh"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.30.1",
    "@solana/spl-token": "^0.4.8",
    "@solana/web3.js": "^1.95.0",
    "bn.js": "^5.2.5"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.0",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^9.0.0",
    "@types/node": "^20.14.10",
    "chai": "^4.3.4",
    "mocha": "^9.0.3",
    "prettier": "^2.6.2",
    "ts-mocha": "^10.0.0",
    "typescript": "^5.4.5"
  }
}
